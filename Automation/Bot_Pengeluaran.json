    {
      "parameters": {
        "jsCode": "// Format the existing message for Telegram\nfunction formatForTelegram(inputText) {\n  // 1. Escape all special MarkdownV2 characters\n  const escapedText = inputText\n    .replace(/\\_/g, '\\\\_')\n    .replace(/\\*/g, '\\\\*')\n    .replace(/\\[/g, '\\\\[')\n    .replace(/\\]/g, '\\\\]')\n    .replace(/\\(/g, '\\\\(')\n    .replace(/\\)/g, '\\\\)')\n    .replace(/\\~/g, '\\\\~')\n    .replace(/\\`/g, '\\\\`')\n    .replace(/\\>/g, '\\\\>')\n    .replace(/\\#/g, '\\\\#')\n    .replace(/\\+/g, '\\\\+')\n    .replace(/\\-/g, '\\\\-')\n    .replace(/\\=/g, '\\\\=')\n    .replace(/\\|/g, '\\\\|')\n    .replace(/\\{/g, '\\\\{')\n    .replace(/\\}/g, '\\\\}');\n    \n  // 2. Replace the bullet points with Telegram-friendly format\n  return escapedText.replace(/\\*\\s+/g, '• ');\n}\n\n// Get the input text (assuming it's in the first item's json.output)\nconst inputText = $input.first().json.output\n\n// Format the message\nconst telegramMessage = formatForTelegram(inputText);\n\n// Return the formatted message for the Telegram node\nreturn {\n  json: {\n    message: telegramMessage,\n    parse_mode: 'MarkdownV2'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4000,
        820
      ],
